# ══════════════════════════════════════════════════════════════════════════
#  Polybot Snipez — Environment Configuration
#
#  SETUP:
#    1. Copy this file to ".env" in the same folder:
#         Windows:  copy .env.example .env
#         Mac/Linux: cp .env.example .env
#    2. Fill in the REQUIRED section below.
#    3. Everything else already has a sane default — only change what you
#       actually want to override.
#
#  ".env" is gitignored and never committed. This file is the template.
# ══════════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────────────
#  REQUIRED — Polymarket credentials
#  The bot will not place orders without all five of these.
# ──────────────────────────────────────────────────────────────────────────

# Private key of the Polygon wallet (EOA) that controls your Polymarket
# account. Export from MetaMask (Account details -> Show private key) or
# from Polymarket -> Settings -> Export Private Key.
# Keep the leading 0x. NEVER share this or commit it anywhere.
POLYMARKET_PRIVATE_KEY=

# Your Polymarket PROXY wallet address — the on-exchange address that
# actually holds your USDC. This is NOT your EOA address.
# Find it on Polymarket: click your profile, copy the 0x... shown there.
# The client runs in POLY_PROXY mode (signature_type=1) and uses this as
# the funder, so a wrong value here means orders sign fine but never fund.
POLYMARKET_PROXY_ADDRESS=

# L2 API credentials. These are NOT issued by Polymarket support or any
# web dashboard — they are derived from your private key by signing a
# message. Run this once after filling in the two values above:
#
#     python derive_creds.py
#
# and paste the three values it prints here.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=


# ──────────────────────────────────────────────────────────────────────────
#  Trading mode — read this before flipping anything
# ──────────────────────────────────────────────────────────────────────────

# true  = simulate every order, spend nothing (dashboard badge is yellow)
# false = REAL MONEY, real orders on Polymarket (badge turns red / LIVE)
# Leave this true until you have watched the scanner and a few paper fills.
PAPER_TRADING=true

# Master kill switch. false = bot places no orders at all, even in live mode.
TRADING_ENABLED=true

# Second ignition key, used by the 90c->99c strategy (strategy_9099.py).
# That strategy sends a real order ONLY when all four of these line up:
#   LIVE_TRADING=true AND PAPER_TRADING=false AND TRADING_ENABLED=true
#   AND MANUAL_ONLY=false
# Anything missing, misspelled or absent leaves it in paper mode, where its
# orders are simulated against the real book and never leave your machine.
LIVE_TRADING=false

# ──────────────────────────────────────────────────────────────────────────
#  Manual-only mode
# ──────────────────────────────────────────────────────────────────────────

# true  = NOTHING trades on its own. Every order comes from a button you
#         click. This disables the 5-min auto-bid engine, the arbitrage
#         engine's automatic scanning, and the scanner's auto-bid sweep,
#         and refuses the dashboard toggles that would re-arm them. A
#         settings.json saved from an earlier session cannot turn them
#         back on either.
# false = the automated strategies are available again (still behind their
#         own individual toggles, which all default to off).
#
# Worth knowing: the arbitrage engine is NOT covered by the dashboard's
# "auto-trade" toggle, and ARB_ENABLED below defaults to true. Without
# MANUAL_ONLY, starting the bot lets the arb engine place its own orders
# while the auto-trade toggle still reads OFF.
MANUAL_ONLY=true

# Default resting exit price ($ per share) pre-filled into the scanner's
# Exit box. When a manual bid fills, a GTC limit SELL is placed at the exit
# price you chose as soon as the conditional tokens settle into the wallet
# — so the order is already in the book when a spike comes through.
# Set MANUAL_EXIT_ENABLED=false to default the box to 0 (bid with no exit).
MANUAL_EXIT_PRICE=0.85
MANUAL_EXIT_ENABLED=true

# How long to keep polling for token settlement before placing the exit
# anyway (seconds). Tokens normally land within a few seconds; the exit
# cannot be placed before they do — that is a Polymarket constraint.
MANUAL_SETTLE_TIMEOUT=120


# ──────────────────────────────────────────────────────────────────────────
#  Dashboard (http://localhost:5050)
# ──────────────────────────────────────────────────────────────────────────

# Password for the dashboard login page. If left blank there is NO login
# at all. The app binds 0.0.0.0, so set this to something real before you
# run it anywhere other than your own machine — and do not port-forward
# 5050 to the internet: it is plain HTTP in front of a button that spends
# your USDC.
DASHBOARD_PASSWORD=

# Flask session signing key. Change it from the default if the dashboard
# is reachable by anyone but you.
FLASK_SECRET=polybot-snipez-2026


# ══════════════════════════════════════════════════════════════════════════
#  OPTIONAL — everything below matches the defaults in config.py.
#  Uncomment and edit only what you want to change.
# ══════════════════════════════════════════════════════════════════════════

# ── API endpoints ─────────────────────────────────────────────────────────
#POLYMARKET_CLOB_URL=https://clob.polymarket.com
#POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# ── Limit bid strategy (the core 5-min Up/Down snipe) ─────────────────────
#BID_PRICE=0.01              # $ per share. Hard ceiling of $0.50 in config.py
#TOKENS_PER_SIDE=100         # Shares per side. Hard ceiling of 500
#MAX_RISK_PER_MARKET=10      # Max $ exposure on any one market
#MAX_DAILY_SPEND=40          # Max $ spent per day across everything
#MAX_BIDS_PER_DAY=20         # 0 = unlimited

# ── Timing (seconds before market close) ─────────────────────────────────
#BID_WINDOW_OPEN=60          # Start posting bids at T-60s
#BID_WINDOW_CLOSE=0          # Stop posting at T-0
#CANCEL_DELAY_AFTER_CLOSE=30 # Wait Ns after close before cancelling
#MARKET_POLL_INTERVAL=60     # Seconds between market discovery sweeps

# ── Combined-ask arbitrage (buy both sides when they total < $1.00) ──────
#ARB_ENABLED=true
#ARB_MIN_EDGE=0.03           # Minimum profit per $1 of payout (3 cents)
#ARB_TRADE_SIZE=5.00         # Max $ per arb trade
#ARB_MAX_POSITIONS=3         # Max concurrent arb positions
#ARB_COOLDOWN=30             # Seconds between arbs on the same market
#ARB_FILL_TIMEOUT=45         # Cancel unfilled arb orders after Ns
#ARB_MAX_DAILY_SPEND=25.00   # Daily spend cap for arb specifically

# ── Scalper ───────────────────────────────────────────────────────────────
#SCALP_TRADE_SIZE=2.50       # $ per scalp trade
#SCALP_ENTRY_ASK_MAX=0.50    # Do not enter above this ask
#SCALP_PROFIT_TARGET=0.04    # Take profit at +4 cents
#SCALP_STOP_LOSS=0.05        # Cut at -5 cents
#SCALP_COOLDOWN=15           # Seconds between scalps
#SCALP_EXIT_BEFORE=30        # Force exit at T-30s before close
#SCALP_MAX_POSITIONS=2       # Max concurrent scalp positions


# ══════════════════════════════════════════════════════════════════════════
#  90c -> 99c LATE-MARKET STRATEGY  (strategy_9099.py / run_9099.py)
#
#  Buy a side that trades up to ~$0.90 late in a 5-minute market, then rest
#  a limit SELL at ~$0.99 for the shares that ACTUALLY filled. Emergency-exit
#  if it reverses. Every candidate is logged whether or not it is traded.
#
#  Start it in paper mode with:   python run_9099.py
#  Nothing below needs changing to run the defaults.
# ══════════════════════════════════════════════════════════════════════════

# ── Master switches ───────────────────────────────────────────────────────
# ENABLED alone only watches and records — it never places an order.
# AUTO_TRADE is what lets a qualifying candidate become a position.
#S9099_ENABLED=true
#S9099_AUTO_TRADE=true
#S9099_KILL_SWITCH=false        # true = stop opening new positions immediately
#S9099_ASSETS=BTC,ETH,SOL,XRP

# ── Entry ─────────────────────────────────────────────────────────────────
#S9099_ENTRY_PRICE_MIN=0.90     # later tests: 0.85 0.88 0.90 0.92 0.94 0.95 0.97
#S9099_ENTRY_PRICE_MAX=0.96     # do not chase past here — no move left
#S9099_ENTRY_SLIPPAGE=0.00      # pay this much over the ask to get filled
#S9099_ENTRY_TIMEOUT=8          # cancel an unfilled entry after N seconds
#S9099_PARTIAL_FILL_GRACE=1.5   # after a partial, wait Ns then rest the TP on what filled

# ── Take profit ───────────────────────────────────────────────────────────
#S9099_TAKE_PROFIT_PRICE=0.99   # resting limit sell (maker — no fee)

# ── Time to expiry ────────────────────────────────────────────────────────
#S9099_MAX_SECS_REMAINING=60    # later tests: 90 60 45 30 20 15 10
#S9099_MIN_SECS_REMAINING=10    # too close to the bell for the TP to fill
#S9099_CANDIDATE_MAX_SECS=120   # start TRACKING this early, even outside the entry window

# ── Confirmation filters ──────────────────────────────────────────────────
#S9099_MAX_SPREAD=0.03
#S9099_MIN_LIQUIDITY=50               # shares resting at the ask we are lifting
#S9099_MIN_TP_DEPTH=0                 # shares bid at/above the TP (0 = record only)
#S9099_MIN_UNDERLYING_MARGIN_PCT=0.02 # how far spot must sit past the candle open
#S9099_MAX_DATA_AGE=5                 # reject a book older than this

# ── Position sizing ───────────────────────────────────────────────────────
#S9099_POSITION_SIZE_MODE=fixed_dollars   # or percent_bankroll
#S9099_FIXED_DOLLARS=25
#S9099_MAX_POSITION_PERCENT=10            # later tests: 10 25 50 75 100
#S9099_MAX_POSITION_DOLLARS=100           # hard cap per entry, whatever the mode says
#S9099_PAPER_BANKROLL=500                 # starting balance in paper mode
#S9099_MIN_SHARES=5                       # Polymarket minimum order size

# ── Emergency exit ────────────────────────────────────────────────────────
#S9099_STOP_PRICE=0.80                # later tests: 0.85 0.80 0.75 0.60
#S9099_EXIT_BEFORE_EXPIRY=3           # flatten at T-Ns (0 = ride into settlement)
#S9099_STOP_ON_THRESHOLD_CROSS=true   # bail if spot crosses back through the strike
#S9099_STOP_VELOCITY_DROP=0.05        # bail on a N-cent drop...
#S9099_STOP_VELOCITY_WINDOW=5         # ...inside this many seconds

# ── Risk limits ───────────────────────────────────────────────────────────
#S9099_MAX_OPEN_POSITIONS=1
#S9099_MAX_DAILY_LOSS=50
#S9099_MAX_CONSECUTIVE_LOSSES=3
#S9099_MIN_BALANCE=50
#S9099_MAX_TRADES_PER_DAY=40
#S9099_MAX_API_ERRORS=5           # stop submitting after N consecutive API failures
#S9099_MARKET_COOLDOWN=30

# ── Optional opposite-side 1c hedge (not part of the MVP) ─────────────────
#S9099_ENABLE_OPPOSITE_HEDGE=false
#S9099_HEDGE_MAX_PRICE=0.01

# ── Fees ──────────────────────────────────────────────────────────────────
# The real rate is read per token from the CLOB's /fee-rate endpoint; this is
# only the fallback when that call fails. 1000 bps (0.10) is what the 5-minute
# crypto markets currently report. Fee = shares x rate x price x (1 - price),
# takers only — a resting maker sell is free.
#S9099_FEE_RATE_DEFAULT_BPS=1000
#S9099_FEES_CHARGE_MAKER=false

# ── Candidate tracking (the data that decides whether this works) ─────────
#S9099_TRACK_CANDIDATES=true
#S9099_TRACK_TARGETS=0.95,0.97,0.98,0.99
#S9099_TRACK_AFTER_CLOSE=20
